{
  "name": "approved-or-denied",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "deck": "node scripts/build-deck.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-share.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name approved-or-denied",
    "build:share": "node scripts/build-share.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "csv-parse": "^7.0.3",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
